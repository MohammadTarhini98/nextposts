# Copy to .env.local (gitignored) and fill in.
#
# Image storage: if the two Supabase values below are left as-is, images are
# saved to ./uploads on this server. Fill them in to use Supabase Storage.

# Optional: folder for locally stored images (default: ./uploads)
# UPLOAD_DIR=uploads

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret: server-side only. Never prefix with NEXT_PUBLIC_ or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for post images (Storage -> New bucket -> Public)
SUPABASE_STORAGE_BUCKET=post-images
